"LH": ExtResource("combo_lh"),
"LLH": ExtResource("combo_llh"),
"LLLH": ExtResource("combo_lllh"),
"HL": ExtResource("combo_hl")
})
abilities = Array[ExtResource("3_ability")]([ExtResource("ab0"), ExtResource("ab1"), ExtResource("ab2"), ExtResource("ab3"), ExtResource("ab4"), ExtResource("ab5"), ExtResource("ab6"), ExtResource("ab7"), ExtResource("ab8"), ExtResource("ab9")])
